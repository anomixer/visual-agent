{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "aipc-agent",
  "version": "0.1.0",
  "identifier": "com.aipc.agent",
  "build": {
    "frontendDist": "../public",
    "devUrl": "http://localhost:3210/",
    "beforeDevCommand": "npm start",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "AI PC Agent",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/server"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
